# =====================================================================
# Media Sorter - Configuration Template (.env.example)
# =====================================================================

# 1. Source directory: folder where new downloads arrive
DOWNLOADS_DIR=./downloads

# 2. Destination directories: where media files are sorted to
MOVIES_DIR=./movies
SHOWS_DIR=./shows

# 3. Execution mode:
# Set to 'false' to immediately move files into movies/shows.
# Set to 'true' to safely preview operations without touching files.
DRY_RUN=false

# Action type: move | copy | link | hardlink
ACTION=move

# Confidence score required (0.0 to 1.0). Uncertain files go to Quarantine review
CONFIDENCE_THRESHOLD=0.75

# Minimum file age in seconds before processing (0 = immediate sorting)
MIN_FILE_AGE_SECONDS=0

# 4. Web Dashboard Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8085

# 5. Database location
DATABASE_PATH=media_sorter.db
